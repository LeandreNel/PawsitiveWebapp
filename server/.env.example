PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pawsitive
# Optional: creates this staff account once; existing accounts are never reset.
INITIAL_STAFF_NAME=Shelter staff
INITIAL_STAFF_EMAIL=
INITIAL_STAFF_PASSWORD=

# PayFast hosted checkout. Use sandbox credentials while testing.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PUBLIC_SITE_URL=https://your-public-site.example
# Set this when the API is hosted on a separate public origin.
PUBLIC_API_URL=